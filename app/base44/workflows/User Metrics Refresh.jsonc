{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 3 * * *",
      "one_time_date": null,
      "timezone": "America/Los_Angeles",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Recomputes the UserMetrics rollup (inquiries, verifications, gates, reviews, mean trust, credits) for every app user each night at 3am so admins have fresh per-user audit metrics.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "user_metrics_refresh",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "refresh": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "refreshUserMetrics",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Refresh user metrics",
            "description": "Aggregate UserEvent + ApiUsage into UserMetrics"
          }
        }
      }
    ]
  },
  "name": "User Metrics Refresh"
}