{
  "name": "ApiUsage",
  "type": "object",
  "properties": {
    "api_key_id": {
      "type": "string",
      "description": "The ApiKey record used for this metered call."
    },
    "user_id": {
      "type": "string",
      "description": "Owning customer (app user) for fast per-user quota aggregation."
    },
    "endpoint": {
      "type": "string",
      "description": "Which API endpoint consumed credits, e.g. warrantApi, gateApi, inquire."
    },
    "credits": {
      "type": "number",
      "description": "Credits consumed by this call (attest=5, gate=1, inquire=10)."
    },
    "month": {
      "type": "string",
      "description": "Billing month as YYYY-MM for monthly quota reset."
    },
    "metadata": {
      "type": "object",
      "description": "Optional context: model_label, domain, lineage_id."
    }
  },
  "required": [
    "user_id",
    "endpoint",
    "credits",
    "month"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}