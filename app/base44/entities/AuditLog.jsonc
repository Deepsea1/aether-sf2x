{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "event_type": {
      "type": "string",
      "enum": [
        "inquiry_created",
        "answer_promoted",
        "correction_logged",
        "gate_decision",
        "review_decision",
        "kill_switch",
        "drift_alert",
        "claim_extracted",
        "evidence_quarantined",
        "policy_checked",
        "policy_blocked",
        "policy_allowed",
        "warrant_issued",
        "warrant_verified",
        "warrant_revoked",
        "warrant_superseded",
        "evidence_added",
        "evidence_removed",
        "review_opened",
        "review_updated",
        "review_resolved",
        "gate_checked",
        "gate_passed",
        "gate_failed",
        "export_created",
        "export_verified",
        "incident_opened",
        "incident_updated",
        "incident_resolved",
        "key_rotated",
        "connector_permission_changed"
      ],
      "description": "Type of governance event \u2014 expanded to the full Aether ledger taxonomy."
    },
    "entity_type": {
      "type": "string",
      "description": "The kind of entity this event concerns."
    },
    "entity_id": {
      "type": "string",
      "description": "The id of the entity this event concerns."
    },
    "actor_id": {
      "type": "string",
      "description": "Who or what triggered the event."
    },
    "tenant_id": {
      "type": "string",
      "description": "Tenant isolation key \u2014 the owning customer/app user. Mandatory for tenant-bound queries."
    },
    "trace_id": {
      "type": "string",
      "description": "Links to the Telemetry trace this event belongs to."
    },
    "summary": {
      "type": "string",
      "description": "Human-readable event summary."
    },
    "metadata": {
      "type": "object",
      "description": "Structured event payload for attestation."
    },
    "previous_event_hash": {
      "type": "string",
      "description": "SHA-256 hash of the previous event in this tenant's chain \u2014 tamper-evidence via hash chaining."
    },
    "event_hash": {
      "type": "string",
      "description": "SHA-256 hash of this event's canonical content (event_type + entity + actor + summary + metadata + previous_event_hash). Detects any modification."
    },
    "signature": {
      "type": "string",
      "description": "Ed25519 signature over event_hash \u2014 proves the event was issued by a trusted signer, not forged."
    },
    "chain_integrity": {
      "type": "boolean",
      "default": true,
      "description": "True when event_hash validates against the content and previous_event_hash chains correctly."
    }
  },
  "required": [
    "event_type",
    "summary"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}