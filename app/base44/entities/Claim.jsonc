{
  "name": "Claim",
  "type": "object",
  "properties": {
    "text": {
      "type": "string",
      "description": "The full claim text \u2014 a discrete, testable assertion."
    },
    "claim_id_ref": {
      "type": "string",
      "description": "External-style reference id (clm_...) for API/MCP compatibility."
    },
    "category": {
      "type": "string",
      "enum": [
        "benchmark_claim",
        "security_claim",
        "financial_claim",
        "legal_claim",
        "medical_claim",
        "marketing_claim",
        "technical_claim",
        "factual_claim",
        "historical_claim",
        "general_claim"
      ],
      "default": "general_claim",
      "description": "Claim category \u2014 drives which policy rule applies."
    },
    "subject": {
      "type": "string",
      "description": "What the claim is about (the entity being asserted)."
    },
    "predicate": {
      "type": "string",
      "description": "The relationship/action being asserted (e.g. 'reduces', 'is', 'requires')."
    },
    "object": {
      "type": "string",
      "description": "The value or target the subject is asserted to have/be."
    },
    "time_scope": {
      "type": "string",
      "description": "Temporal scope if the claim is time-bounded (e.g. 2026-Q3)."
    },
    "jurisdiction": {
      "type": "string",
      "description": "Legal/regulatory jurisdiction if applicable."
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium",
      "description": "Risk tier \u2014 controls evidence threshold + human review requirement."
    },
    "extraction_confidence": {
      "type": "number",
      "description": "0-1 confidence in the extraction (how cleanly the text was decomposed)."
    },
    "source_asset_type": {
      "type": "string",
      "enum": [
        "answer_version",
        "pr_diff",
        "markdown",
        "document",
        "api_submission",
        "manual"
      ],
      "default": "answer_version",
      "description": "Where this claim was extracted from."
    },
    "source_asset_id": {
      "type": "string",
      "description": "Id of the source asset (AnswerVersion id, PR id, etc.)."
    },
    "source_excerpt": {
      "type": "string",
      "description": "The surrounding text the claim was extracted from (for context)."
    },
    "flash_signals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "clear",
              "info",
              "warn",
              "block"
            ]
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "description": "Aether Flash deterministic risk signals detected on this claim."
    },
    "verdict_status": {
      "type": "string",
      "enum": [
        "pending",
        "supported",
        "supported_with_limits",
        "mixed",
        "unsupported",
        "contradicted",
        "unverifiable",
        "out_of_scope"
      ],
      "default": "pending",
      "description": "Aether verdict taxonomy \u2014 the claim-level decision."
    },
    "verdict_confidence": {
      "type": "number",
      "description": "0-1 confidence in the verdict."
    },
    "coverage_state": {
      "type": "string",
      "enum": [
        "unverified",
        "sampled",
        "partial",
        "high_coverage",
        "complete"
      ],
      "default": "unverified",
      "description": "How thoroughly the claim's evidence was evaluated."
    },
    "policy_decision": {
      "type": "string",
      "enum": [
        "pending",
        "allow",
        "warn",
        "require_review",
        "block"
      ],
      "default": "pending",
      "description": "The policy decision applied to this claim."
    },
    "evidence_pack_id": {
      "type": "string",
      "description": "The EvidencePack backing this claim's verdict."
    },
    "warrant_id": {
      "type": "string",
      "description": "The Warrant that signed this claim's verdict (when warranted)."
    },
    "tenant_id": {
      "type": "string",
      "description": "Tenant isolation key \u2014 the owning customer/app user."
    },
    // PUBLICATION FLAG - read this before using any other field to decide what is public.
    //
    // is_public is the ONLY field that means "this claim may be shown to strangers". It is an
    // explicit publication decision and nothing else. It must be set true deliberately, by
    // application code, at the exact point a claim is intentionally published: never inferred,
    // never derived, never defaulted on.
    //
    // It must NOT be inferred from source_asset_type, category, risk_level, tenant_id, or any
    // other field that describes where a claim CAME FROM. Origin is not consent. This rule is
    // written here because inferring it once already caused a live leak: a public search endpoint
    // scoped itself to source_asset_type == 'pr_diff' on the belief that meant "Aether's own demo
    // claims". It does not: githubPrVerify is an authenticated per-customer endpoint, so every
    // paying customer's private-repo PR claims carry that same value, and their verbatim diff
    // text became unauthenticated, cross-tenant, full-text searchable. That commit was reverted.
    //
    // Absent or false means PRIVATE. There is deliberately no schema "default" here: every claim
    // is private unless something explicitly says otherwise, and no default value should ever be
    // added that could turn this into an opt-out. Public readers must filter on
    // { is_public: true } as a hard, non-overridable key (see functions/searchClaims/entry.ts).
    // As of this schema change nothing in the codebase sets it true, so the public set is empty.
    // That is the correct, safe initial state, not a bug to work around.
    //
    // WHY THIS FIELD CARRIES ITS OWN `rls` BLOCK (field-level security), unlike every other
    // property on every entity in this app:
    // The entity-level rls.create/rls.update below are ROW-level predicates - they answer "may
    // this user touch this row at all", not "may this user set this particular field". They admit
    // any authenticated user for a row they own (created_by_id == user.id). Without the field-level
    // rule here, that user could simply include `is_public: true` in an ordinary create/update of
    // their own Claim - alongside arbitrary `text` and forged `verdict_status`/`policy_decision` -
    // and the row would land in the unauthenticated public registry served by
    // functions/searchClaims. Row ownership is not publication authority.
    //
    // So `write` is restricted to role == admin (Base44 Field Level Security: a per-property `rls`
    // block supporting `read`/`write`, docs.base44.com/developers/backend/resources/entities/
    // security). A non-admin's create/update cannot set this field regardless of row ownership.
    // `read` stays open - an owner may see whether their own claim is published; the flag itself
    // discloses nothing.
    //
    // This does NOT constrain the legitimate product flow: the two paths that create Claims -
    // functions/githubPrVerify/entry.ts and shared/claimPersistence.js (the tribunal pipeline) -
    // both write through `base44.asServiceRole` and neither includes `is_public` in its payload.
    // Any future deliberate publication mechanism must be an admin action or a service-role backend
    // function; do not relax this to let a claim's own creator publish it.
    "is_public": {
      "type": "boolean",
      "description": "Explicit publication decision \u2014 true only when this claim was deliberately published for unauthenticated public view. Absent/false means private. Never infer this from source_asset_type, category, or any other origin field. Field-level RLS: writable only by admin (or service-role backend functions), never by the row's own creator.",
      "rls": {
        "read": true,
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional free-text description."
    }
  },
  "required": [
    "text"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.tenant_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}