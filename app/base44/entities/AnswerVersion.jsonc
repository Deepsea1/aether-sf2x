{
  "name": "AnswerVersion",
  "type": "object",
  "properties": {
    "inquiry_id": {
      "type": "string",
      "description": "Reference to the parent Inquiry."
    },
    "version": {
      "type": "number",
      "description": "Sequential version number within an inquiry."
    },
    "answer_text": {
      "type": "string",
      "description": "The warranted answer text."
    },
    "cognitive_state": {
      "type": "object",
      "description": "CognitiveState snapshot: working memory, self-model, reasoning trace."
    },
    "metrics": {
      "type": "object",
      "description": "Epistemic metric snapshot (CE, ECE, UCR, FRR, CR, MTTC, EDS)."
    },
    "warrant_id": {
      "type": "string",
      "description": "Reference to the Decision Validity Warrant."
    },
    "trust_score": {
      "type": "number",
      "description": "Computed trustworthy answer rate 0-100 at creation, used for escalation triggers."
    },
    "stakes_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "description": "Denormalized parent inquiry stakes, used for escalation triggers."
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional free-text description."
    }
  },
  "required": [
    "inquiry_id",
    "answer_text"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}