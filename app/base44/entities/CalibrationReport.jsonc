{
  "name": "CalibrationReport",
  "type": "object",
  "properties": {
    "corpus_version": {
      "type": "string",
      "description": "Versioned corpus the calibration was computed against (e.g. v2)."
    },
    "corpus_size": {
      "type": "number",
      "description": "Number of claims scored."
    },
    "last_run_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the calibration run executed."
    },
    "brier": {
      "type": "number",
      "description": "Overall Brier score: mean((trust/100 - truth_label)^2). Lower is better; 0 is perfect."
    },
    "buckets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "range": {
            "type": "string",
            "description": "Confidence bucket label, e.g. 0.8-0.9."
          },
          "n": {
            "type": "number"
          },
          "mean_predicted": {
            "type": "number",
            "description": "Mean predicted trust/100 in the bucket."
          },
          "mean_actual": {
            "type": "number",
            "description": "Mean ground-truth truth-label in the bucket (0-1)."
          },
          "accuracy": {
            "type": "number",
            "description": "Fraction in the bucket correctly classified (trust>=50 predicts true)."
          },
          "suppressed": {
            "type": "boolean",
            "description": "True when accuracy < 0.65 \u2014 numeric confidence display suppressed, verdict band shown only."
          }
        },
        "required": [
          "range",
          "n",
          "mean_predicted",
          "mean_actual",
          "accuracy"
        ]
      },
      "description": "Per-confidence-bucket calibration (0.6-0.7, 0.7-0.8, 0.8-0.9, 0.9-1.0)."
    },
    "catch_rates": {
      "type": "object",
      "description": "Catch rates per class: TRUE/FABRICATED/CORRUPTED pass rates + thin-coverage abstention rate."
    },
    "model_provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "vendor": {
            "type": "string"
          },
          "model": {
            "type": "string"
          }
        }
      },
      "description": "Roles + vendors used in the calibration run."
    },
    "regression": {
      "type": "boolean",
      "description": "True when FABRICATED catch dropped >10% vs the prior report or Brier increased >0.05 \u2014 blocks release."
    },
    "regression_reason": {
      "type": "string",
      "description": "Why regression was flagged, if it was."
    },
    "grounded": {
      "type": "boolean",
      "description": "Whether the grounding pipeline (fetch/hash/match + tiers) was live for this run."
    },
    "cross_firm": {
      "type": "boolean",
      "description": "Whether the foreign-vendor falsifier ran (Gate 3)."
    },
    "notes": {
      "type": "string",
      "description": "Caveats: corpus lock status, models used, runtime."
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional free-text description."
    }
  },
  "required": [
    "corpus_version",
    "corpus_size",
    "brier",
    "catch_rates"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}