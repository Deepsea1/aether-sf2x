{
  "name": "CorrectionEvent",
  "type": "object",
  "properties": {
    "inquiry_id": {
      "type": "string",
      "description": "Reference to the parent Inquiry."
    },
    "from_version_id": {
      "type": "string",
      "description": "The answer version being corrected."
    },
    "to_version_id": {
      "type": "string",
      "description": "The new answer version that corrects it."
    },
    "from_version": {
      "type": "number"
    },
    "to_version": {
      "type": "number"
    },
    "severity": {
      "type": "string",
      "enum": [
        "minor",
        "moderate",
        "major",
        "critical"
      ],
      "default": "moderate"
    },
    "detected_by": {
      "type": "string",
      "enum": [
        "self",
        "user",
        "reviewer",
        "drift_detector"
      ],
      "default": "self"
    },
    "time_to_correction": {
      "type": "number",
      "description": "Seconds between the original answer and the correction (MTTC)."
    },
    "trust_delta": {
      "type": "number",
      "description": "Change in trustworthy answer rate from the correction."
    },
    "drift_score": {
      "type": "number",
      "description": "Composite drift (BDR/PVVR/OBAD) between the two versions, 0-1."
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "inquiry_id",
    "to_version_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}