{
  "name": "CorrelationAudit",
  "type": "object",
  "properties": {
    "dataset": {
      "type": "string",
      "description": "Benchmark the audit ran against, e.g. TruthfulQA-representative or HaluEval-representative."
    },
    "n_items": {
      "type": "number",
      "description": "Total items evaluated."
    },
    "n_true": {
      "type": "number",
      "description": "Number of ground-truth-true items."
    },
    "n_hallucinated": {
      "type": "number",
      "description": "Number of ground-truth-hallucinated / false items."
    },
    "pearson_r": {
      "type": "number",
      "description": "Pearson correlation between SF2X trust score and truth label (1=true, 0=hallucinated)."
    },
    "spearman_rho": {
      "type": "number",
      "description": "Spearman rank correlation between trust and truth label."
    },
    "auc": {
      "type": "number",
      "description": "ROC AUC treating trust score as the classifier score and truth as the positive class."
    },
    "accuracy": {
      "type": "number",
      "description": "Accuracy at the chosen threshold: trust >= threshold predicts true."
    },
    "threshold": {
      "type": "number",
      "description": "Trust threshold used for the accuracy figure."
    },
    "mean_trust_true": {
      "type": "number",
      "description": "Mean trust score across ground-truth-true items."
    },
    "mean_trust_false": {
      "type": "number",
      "description": "Mean trust score across ground-truth-hallucinated items."
    },
    "separation": {
      "type": "number",
      "description": "mean_trust_true - mean_trust_false; positive means trust separates truth from hallucination."
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim": {
            "type": "string"
          },
          "is_hallucination": {
            "type": "boolean"
          },
          "trust": {
            "type": "number"
          },
          "validity": {
            "type": "string"
          },
          "support_ratio": {
            "type": "number"
          },
          "id": {
            "type": "string",
            "description": "Corpus item id (e.g. T01, F03) so a run's items are traceable back to the versioned corpus."
          },
          "class": {
            "type": "string",
            "description": "Ground-truth class from the negative-control corpus: TRUE | FABRICATED | CORRUPTED | THIN_NEG. LOAD-BEARING — capabilityCard.generateCardData computes the §18.2 false-pass / false-block rates by partitioning on this field, and only counts a run where EVERY item carries it. It was absent from this schema until 2026-08-12, so Base44 stripped it on write and no stored run ever qualified: the capability card could never become measured and enforcing could never unlock."
          },
          "ground_truth": {
            "type": "boolean",
            "description": "Whether the item is true in fact — the label the trust score is scored against."
          },
          "caught": {
            "type": "boolean",
            "description": "Did the pipeline reach the correct disposition for this item? False-pass and false-block rates are computed from this; a missing value counts against us (fail closed)."
          },
          "error": {
            "type": "string",
            "description": "Execution error for this item, when one occurred (e.g. an exhausted integration quota). Its presence marks the run as an incomplete measurement — capabilityCard skips such runs rather than measuring an outage as verifier capability."
          },
          "risk_tier": {
            "type": "string",
            "description": "Risk tier of the corpus item: low | moderate | high | critical. LOAD-BEARING — §18.2 gates enforcement on the high and critical tiers, and capabilityCard computes each tier's false-pass/false-block rate from its OWN items when this is present. Without it the suite-wide aggregate is stamped into all four slots, which is how a critical-tier threshold came to be judged on a corpus containing no critical claims. Absent on v1 runs (unstratified), present on v2-stratified runs."
          }
        }
      },
      "description": "Per-item results: the claim, its ground-truth class and label, the SF2X trust/validity it received, whether the pipeline got it right, and any execution error. The class/caught/error trio is what makes a run measurable for the §18.2 capability card."
    },
    "run_type": {
      "type": "string",
      "enum": [
        "manual",
        "scheduled"
      ],
      "default": "manual"
    },
    "notes": {
      "type": "string",
      "description": "Caveats: sample provenance, verifier model used, date."
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional free-text description."
    }
  },
  "required": [
    "dataset",
    "n_items",
    "pearson_r"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}