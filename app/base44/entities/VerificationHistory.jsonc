{
  "name": "VerificationHistory",
  "type": "object",
  "properties": {
    "trust_score": {
      "type": "number",
      "description": "Trust score 0-100 from the tribunal."
    },
    "verdict": {
      "type": "string",
      "enum": [
        "verified",
        "contested",
        "rejected"
      ],
      "default": "contested",
      "description": "Tribunal verdict."
    },
    "text_preview": {
      "type": "string",
      "maxLength": 500,
      "description": "Preview of the verified text."
    },
    "source": {
      "type": "string",
      "description": "Where the verification came from: api, widget, extension, playground, batch."
    },
    "category": {
      "type": "string",
      "description": "Content category: HR, Legal, Medicine, Engineering, General."
    }
  },
  "required": [
    "trust_score",
    "verdict"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}